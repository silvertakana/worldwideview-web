# Set to "true" to show billing UI (pricing CTAs, subscription management, upgrade prompts)
NEXT_PUBLIC_BILLING_ENABLED=false

# URL pattern for instance setup redirects. {subdomain} is replaced with the instance subdomain.
# Production: NEXT_PUBLIC_INSTANCE_URL_PATTERN=https://{subdomain}.cloud-wwv.dev
# Default (no pattern): no setupUrl is returned, form falls through to onCreated()
NEXT_PUBLIC_INSTANCE_URL_PATTERN=

# Demo instance URL for CTA buttons (Try Demo / Try the Demo)
# Production: https://demo.worldwideview.dev
NEXT_PUBLIC_DEMO_URL=https://demo.worldwideview.dev

# Marketplace URL for nav/footer links
# Production: https://marketplace.worldwideview.dev
NEXT_PUBLIC_MARKETPLACE_URL=https://marketplace.worldwideview.dev

# Base URL for legal page links (e.g., /privacy-policy is appended)
# Production: https://worldwideview.dev/legal
NEXT_PUBLIC_LEGAL_URL=https://worldwideview.dev/legal

# Analytics script URL. Empty = no script rendered.
# Production: https://analytics.worldwideview.dev/script.js
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://analytics.worldwideview.dev/script.js
